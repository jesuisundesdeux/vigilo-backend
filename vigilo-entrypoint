#!/bin/bash
set -e

function log()  {
  echo "$1" > /proc/1/fd/1
}
function logerr() {
  echo "$1" > /proc/1/fd/2
}

APP_DIR=/var/www/html
# Keep the password out of the process list
export MYSQL_PWD="$MYSQL_PASSWORD"

i=0

log "Trying to connect to database ..."
while ! mysql -e ';' -h "$MYSQL_HOST" -u"$MYSQL_USER" "$MYSQL_DATABASE" > /dev/null 2>&1
do
  i=$((i+1))
  log "Trying to connect to database [${i}/30]"
  if [ $i -eq 30 ]
  then
    logerr "Fail to connect to database, please verify that env variables are set and DB is reachable"
    logerr "Exiting ..."
    exit 1
  fi
  sleep 1
done

# The version comes from the code actually served (it may be mounted over the image)
if ! STATUS=$(php /usr/local/bin/vigilo-migrate.php --app="$APP_DIR" --status 2> /proc/1/fd/2)
then
  logerr "Unable to read the database version, refusing to start (nothing was changed)"
  exit 1
fi
read -r DBVER APPVER <<< "$STATUS"

log "DB Version ${DBVER}, APP Version ${APPVER}"

if [ "$(printf '%s\n%s\n' "$DBVER" "$APPVER" | sort -V | tail -1)" != "$APPVER" ]
then
  logerr "Database (${DBVER}) is newer than the code (${APPVER}): refusing to start an older version"
  exit 2
fi

if [ "$DBVER" == "0.0.0" ]
then
  # Fresh database: create the schema, then let the admin create the first account.
  # install.php refuses to run once an account exists.
  log "Empty database, installing ..."
  php /usr/local/bin/vigilo-migrate.php --app="$APP_DIR" > /proc/1/fd/1
  cp /tmp/install_app/install.php "$APP_DIR/install.php"
  chown 33:33 "$APP_DIR/install.php"
elif [ "$DBVER" != "$APPVER" ]
then
  if [ "$AUTOUPDATE" != "false" ]
  then
    log "Upgrading DB ..."
    # Exit code 2: database newer than the code, the container must not start
    php /usr/local/bin/vigilo-migrate.php --app="$APP_DIR" > /proc/1/fd/1
    log "DB upgraded successfully !"
  else
    log "AUTOUPDATE=false: apply the migrations from the admin (Mises à jour) or set AUTOUPDATE to true"
  fi
fi

# first arg is `-f` or `--some-option`
if [ "${1#-}" != "$1" ]; then
        set -- apache2-foreground "$@"
fi

exec "$@"
