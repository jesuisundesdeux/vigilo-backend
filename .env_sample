# Apply database migrations when the container starts (false: apply them from the admin)
AUTOUPDATE=true

# Context
VOLUME_PATH=/data/docker
BIND=0.0.0.0:80

# Database creation
MYSQL_ROOT_PASSWORD=xxxx
MYSQL_USER=mysqluser
MYSQL_PASSWORD=xxxx
MYSQL_HOST=db
MYSQL_DATABASE=vigilodb

DOCKER_GROUP_ID=990

# Image of the backend: the "0.0" tag follows the patches of the 0.0 series
VIGILO_IMAGE=vigilobs/vigilo-backend:0.0

# Updates from the admin with Watchtower (docker compose --profile watchtower up -d)
# WATCHTOWER_TOKEN=a-long-random-string
# VIGILO_WATCHTOWER_URL=http://watchtower:8080

# Blur server: faces and licence plates masked on the photos (docker compose --profile blur up -d)
# VIGILO_BLUR_URL=http://blur:8000/blur
